      "properties": {
        "draftsman": "comfy-draftsman"
      },
      "widgets_values": [
        "### Conditioning\n\nWires the prompt into the model - nothing to edit\nhere; change the prompt itself upstream (Inputs or\nPrompt Building)."
      ],
      "title": "Conditioning",
      "color": "#432",
      "bgcolor": "#653"
    },
